GOOGLE_PLACES_API_KEY=your_google_places_api_key
VITE_GOOGLE_MAPS_BROWSER_KEY=your_browser_maps_key
# Optional production map ID; DEMO_MAP_ID is used for development without one.
VITE_GOOGLE_MAPS_MAP_ID=your_google_map_id

# Optional accounts. Leave blank for a fully local Guest build.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional account deletion; server only, never use a VITE_ prefix.
SUPABASE_SECRET_KEY=
