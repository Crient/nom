{
  "name": "nom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:validate && npm run accounts:validate && vite build && node scripts/validate-account-secrets.mjs --dist",
    "preview": "vite preview",
    "test": "vitest run",
    "catalog:import": "python3 scripts/import-catalog.py",
    "catalog:check": "python3 scripts/import-catalog.py --check",
    "images:prepare": "python3 scripts/import-dish-images.py",
