    "images:remaining": "node scripts/export-missing-images.mjs",
    "catalog:validate": "node scripts/validate-catalog.mjs",
    "ship": "bash scripts/ship.sh",
    "accounts:validate": "node scripts/validate-account-secrets.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.93.3",
    "react": "^19.3.0",
