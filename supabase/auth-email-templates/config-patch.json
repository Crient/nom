{
  "mailer_subjects_confirmation": "Confirm your Nom account",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your Nom account</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Welcome to Nom.</h1><p style=\"font-size:16px;line-height:1.6\">Confirm your email address to finish creating your account and keep your food journey synced across devices.</p><p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#075f58;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none\">Confirm email</a></p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you did not create this Nom account, you can ignore this email.</p></main></body></html>\n",
  "mailer_subjects_recovery": "Reset your Nom password",
  "mailer_templates_recovery_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Reset your Nom password</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Reset your Nom password</h1><p style=\"font-size:16px;line-height:1.6\">We received a request to reset the password for your Nom account.</p><p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#075f58;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none\">Reset password</a></p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you did not request a password reset, you can ignore this email.</p></main></body></html>\n",
  "mailer_subjects_email_change": "Confirm your Nom email change",
  "mailer_templates_email_change_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your Nom email change</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Confirm your email change</h1><p style=\"font-size:16px;line-height:1.6\">Confirm this email address for your Nom account.</p><p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#075f58;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none\">Confirm email change</a></p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you did not request this change, keep your current email address and review your account.</p></main></body></html>\n",
  "mailer_subjects_invite": "Your invitation to Nom",
  "mailer_templates_invite_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your invitation to Nom</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">You\u2019re invited to Nom.</h1><p style=\"font-size:16px;line-height:1.6\">Accept your invitation to create your Nom account.</p><p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#075f58;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none\">Accept invitation</a></p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you were not expecting this invitation, you can ignore this email.</p></main></body></html>\n",
  "mailer_subjects_magic_link": "Sign in to your Nom account",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Sign in to your Nom account</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Sign in to Nom</h1><p style=\"font-size:16px;line-height:1.6\">Use this link to sign in to your Nom account.</p><p><a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#075f58;color:#ffffff;padding:12px 20px;border-radius:8px;text-decoration:none\">Sign in</a></p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you did not request this link, you can ignore this email.</p></main></body></html>\n",
  "mailer_subjects_reauthentication": "Confirm your Nom account action",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Confirm your Nom account action</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Confirm your account action</h1><p style=\"font-size:16px;line-height:1.6\">Enter this confirmation code in Nom to continue.</p><p style=\"font-size:24px;font-weight:700\">{{ .Token }}</p><p style=\"font-size:14px;line-height:1.6;color:#52645f\">If you did not request this code, you can ignore this email.</p></main></body></html>\n",
  "mailer_subjects_password_changed_notification": "Your Nom password was changed",
  "mailer_templates_password_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Nom password was changed</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Your Nom password was changed.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not change it, open Nom and request a password reset.</p></main></body></html>\n",
  "mailer_subjects_email_changed_notification": "Your Nom email address was changed",
  "mailer_templates_email_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Nom email address was changed</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Your Nom email address was changed.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not request this change, review your account in Nom.</p></main></body></html>\n",
  "mailer_subjects_phone_changed_notification": "Your Nom phone number was changed",
  "mailer_templates_phone_changed_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Nom phone number was changed</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">Your Nom phone number was changed.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not request this change, review your account in Nom.</p></main></body></html>\n",
  "mailer_subjects_identity_linked_notification": "A sign-in method was added to Nom",
  "mailer_templates_identity_linked_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>A sign-in method was added to Nom</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">A sign-in method was added to your Nom account.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not add it, review your account in Nom.</p></main></body></html>\n",
  "mailer_subjects_identity_unlinked_notification": "A sign-in method was removed from Nom",
  "mailer_templates_identity_unlinked_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>A sign-in method was removed from Nom</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">A sign-in method was removed from your Nom account.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not remove it, review your account in Nom.</p></main></body></html>\n",
