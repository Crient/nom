  "mailer_templates_mfa_factor_enrolled_notification_content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>A verification method was added to Nom</title></head><body style=\"margin:0;background:#faf8f3;color:#173c37;font-family:Arial,sans-serif\"><main style=\"max-width:520px;margin:32px auto;padding:28px;background:#ffffff;border-radius:16px\"><p style=\"font-size:26px;font-weight:700;color:#075f58\">Nom</p><h1 style=\"font-size:24px\">A verification method was added to your Nom account.</h1><p style=\"font-size:16px;line-height:1.6\">If you did not add it, review your account in Nom.</p></main></body></html>\n",
